# MongoDB connection
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=datalensai

# Session security
SESSION_SECRET_KEY=change-me-to-a-random-64-char-hex-string
SESSION_EXPIRE_HOURS=24

# Admin bootstrap — used ONLY by scripts/create_admin.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Admin

# Initial invitation code — created on first startup if no codes exist
INITIAL_INVITE_CODE=change-me-to-a-secret-code

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Local LLM via Ollama (no paid API needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
